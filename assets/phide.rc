#include <windows.h>

101 ICON "assets\\phide.ico"
1 24 "assets\\phide.exe.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Phide Studio"
            VALUE "FileDescription", "phide - Web Development IDE"
            VALUE "FileVersion", "2026.b"
            VALUE "InternalName", "phide.exe"
            VALUE "OriginalFilename", "phide.exe"
            VALUE "ProductName", "phide - Web Development IDE"
            VALUE "ProductVersion", "2026.b"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
