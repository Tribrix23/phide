{
    // User Code Snippets for phide IDE
    // Each snippet is defined under a snippet name and has a prefix, body, description, and scope.
    // Use $1, $2 for tab stops, $0 for final cursor position, and ${1:label} for placeholders.

    "HTML5 Boilerplate Template (!)": {
        "prefix": "!",
        "body": [
            "<!DOCTYPE html>",
            "<html lang=\"en\">",
            "<head>",
            "    <meta charset=\"UTF-8\">",
            "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
            "    <title>${1:Document}</title>",
            "</head>",
            "<body>",
            "    $0",
            "</body>",
            "</html>"
        ],
        "description": "Complete HTML5 boilerplate skeleton with DOCTYPE, meta charset, viewport, title, and body",
        "scope": "html,htm,php"
    },

    "HTML5 Boilerplate (html:5)": {
        "prefix": "html:5",
        "body": [
            "<!DOCTYPE html>",
            "<html lang=\"en\">",
            "<head>",
            "    <meta charset=\"UTF-8\">",
            "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
            "    <title>${1:Document}</title>",
            "</head>",
            "<body>",
            "    $0",
            "</body>",
            "</html>"
        ],
        "description": "Complete HTML5 boilerplate skeleton with DOCTYPE, meta charset, viewport, title, and body",
        "scope": "html,htm,php"
    },

